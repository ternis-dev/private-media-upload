APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- private.wf domain (same contract as the lean router, openapi 0.4.0) ---
# Storage selection per tier. Empty S3_L1_ENDPOINT+S3_L1_KEY = emulation.
APP_URL=http://localhost:8000
WEB_URL=http://localhost:3000
VAR_DIR=./var
DB_PATH=./var/privatewf.sqlite
# pgsql prod alternative (primary): DB_DSN="pgsql:host=…;dbname=…" DB_USER=… DB_PASS=…
#DB_DSN=
#DB_USER=
#DB_PASS=
USER_QUOTA_BYTES=10737418240
HMAC_SECRET=changeme-sovereign
AUDIT_SALT=
S3_L1_ENDPOINT=
S3_L1_BUCKET=privatewf-l1
S3_L1_KEY=
S3_L1_SECRET=
S3_L1_REGION=auto
S3_L1_PUBLIC_BASE=https://r2.private.wf
S3_L1_EMU_ROOT=/tmp/pwf-l1-emu
SFTP_L2_HOST=
SFTP_L2_PORT=22
SFTP_L2_USER=
SFTP_L2_PASSWORD=
SFTP_L2_KEY_FILE=
SFTP_L2_KEY_PASSPHRASE=
SFTP_L2_ROOT=/vault
SFTP_L2_EMU_ROOT=/tmp/pwf-l2-emu
SOVEREIGN_PATH=/tmp/pwf-sovereign
CLAMAV_HOST=
CLAMAV_PORT=3310
