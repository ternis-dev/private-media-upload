# Used by docker compose + apps/api + apps/web. Never commit real secrets.
APP_ENV=local
APP_URL=http://localhost:8000
WEB_URL=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=privatewf
DB_USERNAME=privatewf
DB_PASSWORD=changeme

REDIS_HOST=redis
REDIS_PORT=6379

# L1 — S3-compatible (MinIO = local R2 fake)
S3_L1_ENDPOINT=http://minio:9000
S3_L1_BUCKET=privatewf-l1
S3_L1_KEY=minioadmin
S3_L1_SECRET=minioadmin
S3_L1_REGION=auto

# L2 — SFTP vault DE (local fake via openssh container)
SFTP_L2_HOST=sftp
SFTP_L2_PORT=22
SFTP_L2_USER=vault
SFTP_L2_PASSWORD=changeme
SFTP_L2_ROOT=/vault

# L3 — sovereign local node
SOVEREIGN_PATH=/srv/private-wf/vault

MAIL_HOST=mailpit
MAIL_PORT=1025
CLAMAV_HOST=clamav
