# Used by docker compose + apps/api + apps/web. Never commit real secrets.
APP_ENV=local
APP_URL=http://localhost:8000
WEB_URL=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=privatewf
DB_USERNAME=privatewf
DB_PASSWORD=changeme

REDIS_HOST=redis
REDIS_PORT=6379

# L1 — S3-compatible (MinIO = local R2 fake)
S3_L1_ENDPOINT=http://minio:9000
S3_L1_BUCKET=privatewf-l1
S3_L1_KEY=minioadmin
S3_L1_SECRET=minioadmin
S3_L1_REGION=auto
S3_L1_PUBLIC_BASE=https://r2.private.wf
S3_L1_EMU_ROOT=/tmp/pwf-l1-emu
# Empty S3_L1_ENDPOINT+S3_L1_KEY = emulation mode (no network, M1 dev default).
# Set real endpoint+key for SigV4 presigned browser-direct uploads.

# L2 — SFTP vault DE (Hetzner box / compose sftp fake)
SFTP_L2_HOST=sftp
SFTP_L2_PORT=22
SFTP_L2_USER=vault
SFTP_L2_PASSWORD=changeme
SFTP_L2_KEY_FILE=
SFTP_L2_KEY_PASSPHRASE=
SFTP_L2_ROOT=/vault
SFTP_L2_EMU_ROOT=/tmp/pwf-l2-emu
# Empty SFTP_L2_HOST+SFTP_L2_USER = emulation mode (local dir, zero infra).

# L3 — sovereign local node
SOVEREIGN_PATH=/srv/private-wf/vault

# API runtime
HMAC_SECRET=changeme-sovereign
AUDIT_SALT=
VAR_DIR=./var
DB_PATH=./var/privatewf.sqlite
NEXT_PUBLIC_API_BASE=http://localhost:8000
API_BASE=http://localhost:8000

MAIL_HOST=mailpit
MAIL_PORT=1025
CLAMAV_HOST=
CLAMAV_PORT=3310
# Empty CLAMAV_HOST = scan skipped (dev default). Compose: CLAMAV_HOST=clamav.
