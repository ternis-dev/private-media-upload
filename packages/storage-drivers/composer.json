{
  "name": "ternis/storage-drivers",
  "description": "Framework-agnostic storage abstraction for private.wf (L1 R2/S3, L2 SFTP vault, L3 sovereign local)",
  "license": "AGPL-3.0-or-later",
  "type": "library",
  "require": {
    "php": "^8.3",
    "aws/aws-sdk-php": "^3.0",
    "phpseclib/phpseclib": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "PrivateWf\\Storage\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "PrivateWf\\Storage\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit --colors=always"
  }
}
